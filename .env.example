# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git and must never be committed.

# Groq API key for the website chat assistant (https://console.groq.com)
GROQ_API_KEY=

# Resend API key for demo request emails and newsletter events (https://resend.com)
RESEND_API_KEY=

# Where demo requests are delivered
DEMO_TO_EMAIL=you@example.com

# Sender address. "onboarding@resend.dev" works until you verify your own domain in Resend,
# and then only delivers to the email that owns the Resend account.
RESEND_FROM=One Tech <onboarding@resend.dev>
